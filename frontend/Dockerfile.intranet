FROM node:22-alpine AS build
WORKDIR /src
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run typecheck && npm run build:intranet
FROM nginxinc/nginx-unprivileged:1.28-alpine
COPY deploy/nginx-intranet.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/intranet /usr/share/nginx/html
EXPOSE 8080
