# Generate unique secrets with: python scripts/generate_secrets.py
INTERNET_DB_PASSWORD=replace-with-random-password
INTRANET_DB_PASSWORD=replace-with-random-password
INTERNET_REDIS_PASSWORD=replace-with-random-password
INTRANET_REDIS_PASSWORD=replace-with-random-password
TRANSFER_QUEUE_PASSWORD=replace-with-random-password
INTERNET_SECRET_KEY=replace-with-at-least-32-random-characters
INTRANET_SECRET_KEY=replace-with-a-different-32-character-secret
INTERNET_FIELD_KEY=replace-with-url-safe-base64-32-byte-key
INTRANET_FIELD_KEY=replace-with-a-different-url-safe-base64-key
INTERNET_ADMIN_PASSWORD=replace-with-strong-admin-password
INTRANET_ADMIN_PASSWORD=replace-with-different-strong-admin-password
TRANSFER_SECRET=replace-with-at-least-32-random-characters
TRANSFER_API_KEY=replace-with-at-least-24-random-characters
TRANSFER_ENCRYPTION=AES-256-GCM
# For the national-cryptography profile set TRANSFER_ENCRYPTION=SM4-CBC and configure:
SM2_RECIPIENT_PRIVATE_KEY=
SM2_RECIPIENT_PUBLIC_KEY=
SM2_SIGNING_PRIVATE_KEY=
SM2_SIGNING_PUBLIC_KEY=
# Optional intranet LDAP/AD (local administrator remains available)
AUTH_MODE=local
LDAP_SERVER_URL=ldaps://ad.internal.example:636
LDAP_BASE_DN=DC=internal,DC=example
LDAP_BIND_DN=CN=svc-health,OU=Service Accounts,DC=internal,DC=example
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_DEFAULT_ROLE=read_only
# API polling stays disabled in the isolated baseline; enable only through an HTTPS allowlisted gateway.
ENABLE_API_POLLING=false
API_POLL_BASE_URL=
